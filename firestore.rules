rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function notGuest() {
      return signedIn();
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.isAdmin == true;
    }

    // ===== chatMessages =====
    match /chatMessages/{doc} {
      // 7-day TTL: any signed-in user may hard-delete messages older than 7 days
      // (client-side cleanup in src/chatTtl.js) so old chat docs don't pile up.
      function isExpiredChatMessage() {
        return (resource.data.createdAt is number && resource.data.createdAt < request.time.toMillis() - 604800000)
          || (resource.data.createdAt is timestamp && resource.data.createdAt < request.time);
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100
        && request.resource.data.roomId is string
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isExpiredChatMessage());
    }

    // ===== dailyScores =====
    match /dailyScores/{doc} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is int
        && request.resource.data.gameId is string
        && request.resource.data.score is number;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== gameReactions =====
    match /gameReactions/{doc} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.emoji is string
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // ===== friendRequests / messages (legacy) =====
    match /friendRequests/{doc} {
      allow read, write: if signedIn();
    }
    match /messages/{doc} {
      allow read, write: if signedIn();
    }

    // ===== leagues =====
    match /leagues/{leagueId} {
      allow read: if notGuest();
      allow create: if notGuest()
        && request.resource.data.players is list
        && request.resource.data.status is string;
      allow update: if notGuest()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'status', 'completedAt', 'seasonStart', 'rank', 'instance', 'createdAt'
        ]);
      allow delete: if false;
    }

    // ===== matches =====
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.player1 is string
        && request.resource.data.player2 is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'result', 'acceptedAt', 'finishedAt'
        ]);
      allow delete: if false;
    }

    // ===== tournaments =====
    match /tournaments/{tournamentId} {
      allow read: if notGuest();
      allow create: if notGuest()
        && request.resource.data.players is list
        && request.resource.data.status is string;
      allow update: if notGuest()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'status', 'stage', 'season', 'completedAt', 'createdAt',
          'startsAt', 'stageStartedAt', 'stageEndsAt', 'cancelledAt'
        ]);
      allow delete: if false;
    }

    // ===== config (shop sales, announcements, misc settings) =====
    match /config/{configId} {
      // Each config doc validates its own known shape; unknown docs are rejected.
      function isShopSale() { return configId == 'shopSale'; }
      function isAnnouncement() { return configId == 'announcement'; }
      function isChatControls() { return configId == 'chatControls'; }
      function isBlacklist() { return configId == 'blacklist'; }

      function validShopSaleCreate() {
        return isShopSale()
          && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
          && request.resource.data.items is map
          && request.resource.data.updatedAt is number;
      }
      function validShopSaleUpdate() {
        return isShopSale()
          && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
          && request.resource.data.items is map
          && request.resource.data.updatedAt is number
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'updatedAt']);
      }

      function validAnnouncementBanner(b) {
        return b is map
          && b.keys().hasOnly(['text', 'color', 'emoji', 'enabled'])
          && b.text is string
          && b.text.size() <= 200
          && b.color is string
          && b.color.size() <= 20
          && b.emoji is string
          && b.emoji.size() <= 8
          && b.enabled is bool;
      }
      function validAnnouncementCreate() {
        return isAnnouncement()
          && request.resource.data.keys().hasOnly(['banners', 'enabled', 'updatedAt'])
          && request.resource.data.banners is list
          && request.resource.data.banners.size() <= 3
          && (request.resource.data.banners.size() == 0
              || validAnnouncementBanner(request.resource.data.banners[0]))
          && (request.resource.data.banners.size() <= 1
              || validAnnouncementBanner(request.resource.data.banners[1]))
          && (request.resource.data.banners.size() <= 2
              || validAnnouncementBanner(request.resource.data.banners[2]))
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is number;
      }
      function validAnnouncementUpdate() {
        return isAnnouncement()
          && validAnnouncementCreate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banners', 'enabled', 'updatedAt', 'text']);
      }

      function validChatControlsCreate() {
        return isChatControls()
          && request.resource.data.keys().hasOnly(['enabled', 'updatedAt'])
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is number;
      }
      function validChatControlsUpdate() {
        return isChatControls()
          && request.resource.data.keys().hasOnly(['enabled', 'updatedAt'])
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is number
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'updatedAt']);
      }

      function validBlacklistCreate() {
        return isBlacklist()
          && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 100
          && request.resource.data.updatedAt is number;
      }
      function validBlacklistUpdate() {
        return isBlacklist()
          && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 100
          && request.resource.data.updatedAt is number
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['words', 'updatedAt']);
      }

      // Announcement is public so all users see it; other config docs require sign-in
      allow read: if signedIn() || configId == 'announcement';
      allow create: if signedIn()
        && (validShopSaleCreate() || validAnnouncementCreate() || validChatControlsCreate()
          || (isAdmin() && validBlacklistCreate()));
      allow update: if signedIn()
        && (validShopSaleUpdate() || validAnnouncementUpdate() || validChatControlsUpdate()
          || (isAdmin() && validBlacklistUpdate()));
      allow delete: if false;
    }

    // ===== moderation (warnings, temp bans, permanent bans) =====
    match /moderation/{playerId} {
      function validModeration() {
        return request.resource.data.keys().hasOnly([
            'userId', 'type', 'reason', 'until', 'issuedAt', 'issuedBy', 'username'
          ])
          && request.resource.data.userId == playerId
          && request.resource.data.type in ['warn', 'temp', 'permanent']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 300
          && ((request.resource.data.type == 'temp'
                && request.resource.data.until is number
                && request.resource.data.until > request.time.toMillis())
              || (request.resource.data.type != 'temp'
                && request.resource.data.until == null))
          && request.resource.data.issuedAt is number
          && request.resource.data.issuedBy is string
          && request.resource.data.username is string
          && request.resource.data.username.size() <= 50;
      }

      allow read: if signedIn();
      allow create, update: if signedIn() && isAdmin() && validModeration();
      allow delete: if signedIn() && isAdmin();
    }

    // ===== usernames (unique handle registry) =====
    // Doc ID is the lowercase username; only one doc can exist per name, so
    // ownership of the matching doc is the source of truth for uniqueness.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    // ===== players =====
    match /players/{playerId} {
      // Cross-user player updates are only the narrow operations the app
      // legitimately performs: league/tournament season adjustments, match
      // results, referral rewards, and adding/removing yourself from a
      // friend's friend list. Everything else is owner-only.
      function isPermittedCrossPlayerUpdate() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly([
          'coins', 'xp', 'referrals', 'wins', 'losses', 'streak',
          'promotions', 'tournamentTickets', 'tournamentWins', 'firstPlaceFinishes',
          'league', 'leagueInstanceId', 'friends', 'lastActive'
        ])
          && isBoundedLeaderboardChange()
          && (!keys.hasAny(['friends']) || isFriendsSelfMutation());
      }

      // For every numeric field: either it is untouched (equals the existing
      // value) or the change is within the bounds the app legitimately writes.
      function isBoundedLeaderboardChange() {
        return (request.resource.data.coins == resource.data.coins
            || (request.resource.data.coins >= resource.data.coins && request.resource.data.coins <= resource.data.coins + 3000))
          && (request.resource.data.xp == resource.data.xp
            || (request.resource.data.xp >= resource.data.xp - 5 && request.resource.data.xp <= resource.data.xp + 50))
          && (request.resource.data.referrals == resource.data.referrals
            || (request.resource.data.referrals >= resource.data.referrals && request.resource.data.referrals <= resource.data.referrals + 1))
          && (request.resource.data.wins == resource.data.wins
            || (request.resource.data.wins >= resource.data.wins && request.resource.data.wins <= resource.data.wins + 1))
          && (request.resource.data.losses == resource.data.losses
            || (request.resource.data.losses >= resource.data.losses && request.resource.data.losses <= resource.data.losses + 1))
          && (request.resource.data.streak == resource.data.streak
            || (request.resource.data.streak >= -100 && request.resource.data.streak <= 100))
          && (request.resource.data.promotions == resource.data.promotions
            || (request.resource.data.promotions >= resource.data.promotions && request.resource.data.promotions <= resource.data.promotions + 1))
          && (request.resource.data.tournamentTickets == resource.data.tournamentTickets
            || (request.resource.data.tournamentTickets >= resource.data.tournamentTickets - 1 && request.resource.data.tournamentTickets <= resource.data.tournamentTickets))
          && (request.resource.data.tournamentWins == resource.data.tournamentWins
            || (request.resource.data.tournamentWins >= resource.data.tournamentWins && request.resource.data.tournamentWins <= resource.data.tournamentWins + 1))
          && (request.resource.data.firstPlaceFinishes == resource.data.firstPlaceFinishes
            || (request.resource.data.firstPlaceFinishes >= resource.data.firstPlaceFinishes && request.resource.data.firstPlaceFinishes <= resource.data.firstPlaceFinishes + 1))
          && (request.resource.data.league == resource.data.league
            || (request.resource.data.league >= 1 && request.resource.data.league <= 11))
          && (request.resource.data.leagueInstanceId == resource.data.leagueInstanceId
            || request.resource.data.leagueInstanceId is string
            || request.resource.data.leagueInstanceId == null);
      }

      function isFriendsSelfMutation() {
        let old = resource.data.friends;
        let next = request.resource.data.friends;
        // self added to an empty friend list
        return (old == null && next is list && next.size() == 1 && next.hasAny([request.auth.uid]))
          // self added (arrayUnion): old kept intact + self appended
          || (old != null && next is list && next.size() == old.size() + 1 && next.hasAll(old) && next.hasAny([request.auth.uid]))
          // self removed (arrayRemove): old minus self
          || (old != null && next is list && next.size() == old.size() - 1 && old.hasAll(next) && !next.hasAny([request.auth.uid]));
      }

      // Username changes are only allowed if the player owns the matching
      // lowercase claim doc in /usernames (guaranteed unique by doc ID).
      function isValidUsernameClaim() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        // Null->null writes are harmless legacy field backfills, not claims.
        let nullToNull = request.resource.data.username == null && resource.data.username == null;
        let term = request.resource.data.username.lower();
        return !affected.hasAny(['username'])
          || nullToNull
          || (request.resource.data.username is string
            && request.resource.data.username.size() >= 3
            && request.resource.data.username.size() <= 20
            && request.resource.data.username.matches('^[a-zA-Z0-9_]+$')
            && exists(/databases/$(database)/documents/usernames/$(term))
            && get(/databases/$(database)/documents/usernames/$(term)).data.uid == request.auth.uid);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == playerId;
      allow update: if signedIn()
        && ((request.auth.uid == playerId && isValidUsernameClaim())
            || isPermittedCrossPlayerUpdate());
      allow delete: if false;
    }
  }
}
