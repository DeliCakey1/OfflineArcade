rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ===== chatMessages =====
    match /chatMessages/{doc} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100
        && request.resource.data.roomId is string
        && request.resource.data.createdAt is number;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== dailyScores =====
    match /dailyScores/{doc} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is int
        && request.resource.data.gameId is string
        && request.resource.data.score is number;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ===== gameReactions =====
    match /gameReactions/{doc} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.emoji is string
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // ===== friendRequests / messages (legacy) =====
    match /friendRequests/{doc} {
      allow read, write: if signedIn();
    }
    match /messages/{doc} {
      allow read, write: if signedIn();
    }

    // ===== leagues =====
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.status is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'status', 'completedAt', 'seasonStart', 'rank', 'instance', 'createdAt'
        ]);
      allow delete: if false;
    }

    // ===== matches =====
    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.player1 is string
        && request.resource.data.player2 is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'result', 'acceptedAt', 'finishedAt'
        ]);
      allow delete: if false;
    }

    // ===== tournaments =====
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.status is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'players', 'status', 'stage', 'season', 'completedAt', 'createdAt'
        ]);
      allow delete: if false;
    }

    // ===== players =====
    match /players/{playerId} {
      // Cross-user player updates are only the narrow operations the app
      // legitimately performs: league/tournament season adjustments, match
      // results, referral rewards, and adding/removing yourself from a
      // friend's friend list. Everything else is owner-only.
      function isPermittedCrossPlayerUpdate() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly([
          'coins', 'xp', 'referrals', 'wins', 'losses', 'streak',
          'promotions', 'tournamentTickets', 'tournamentWins', 'firstPlaceFinishes',
          'league', 'leagueInstanceId', 'friends', 'lastActive'
        ])
          && isBoundedLeaderboardChange()
          && (isFriendsSelfMutation() || request.resource.data.friends == resource.data.friends);
      }

      function isBoundedLeaderboardChange() {
        return request.resource.data.coins >= resource.data.coins
          && request.resource.data.coins <= resource.data.coins + 3000
          && request.resource.data.xp >= resource.data.xp - 5
          && request.resource.data.xp <= resource.data.xp + 50
          && request.resource.data.referrals >= resource.data.referrals
          && request.resource.data.referrals <= resource.data.referrals + 1
          && request.resource.data.wins >= resource.data.wins
          && request.resource.data.wins <= resource.data.wins + 1
          && request.resource.data.losses >= resource.data.losses
          && request.resource.data.losses <= resource.data.losses + 1
          && request.resource.data.streak >= -100
          && request.resource.data.streak <= 100
          && request.resource.data.promotions >= resource.data.promotions
          && request.resource.data.promotions <= resource.data.promotions + 1
          && request.resource.data.tournamentTickets >= resource.data.tournamentTickets - 1
          && request.resource.data.tournamentTickets <= resource.data.tournamentTickets
          && request.resource.data.tournamentWins >= resource.data.tournamentWins
          && request.resource.data.tournamentWins <= resource.data.tournamentWins + 1
          && request.resource.data.firstPlaceFinishes >= resource.data.firstPlaceFinishes
          && request.resource.data.firstPlaceFinishes <= resource.data.firstPlaceFinishes + 1
          && request.resource.data.league >= 1
          && request.resource.data.league <= 11;
      }

      function isFriendsSelfMutation() {
        let old = resource.data.friends;
        let next = request.resource.data.friends;
        if (old != null) {
          // self added (arrayUnion): old kept intact + self appended
          let added = next.hasAll(old) && next.size() == old.size() + 1 && next.hasAny([request.auth.uid]);
          // self removed (arrayRemove): old minus self
          let removed = old.hasAll(next) && next.size() == old.size() - 1 && !next.hasAny([request.auth.uid]);
          return added || removed;
        }
        return next.hasAny([request.auth.uid]) && next.size() == 1;
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == playerId;
      allow update: if signedIn()
        && (request.auth.uid == playerId || isPermittedCrossPlayerUpdate());
      allow delete: if false;
    }
  }
}
