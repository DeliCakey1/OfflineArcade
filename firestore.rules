rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /chatMessages/{doc} {
      allow read, write: if request.auth != null;
    }
    match /dailyScores/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /friendRequests/{doc} {
      allow read, write: if request.auth != null;
    }
    match /gameReactions/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /messages/{doc} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
